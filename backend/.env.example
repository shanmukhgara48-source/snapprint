# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<64-character-random-hex>

# Firebase Admin SDK
# Prefer FIREBASE_CREDENTIALS_JSON in hosted environments. Paste the entire
# service-account JSON as one line. For local/server file mounts, keep the JSON
# outside this repository and point FIREBASE_CREDENTIALS_PATH at that file.
FIREBASE_CREDENTIALS_JSON=<one-line-firebase-service-account-json>
FIREBASE_CREDENTIALS_PATH=/secure/path/outside/repo/firebase-admin.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Web API Key (from Firebase Console → Project Settings → Web API Key)
FIREBASE_API_KEY=<firebase-web-api-key>

# Razorpay — use rzp_live_* keys for production
RAZORPAY_KEY_ID=rzp_live_<key-id>
RAZORPAY_KEY_SECRET=<live-key-secret>

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-unique-password>

# Cloudflare R2 (rotate the keys that were previously exposed)
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=snap-photo
R2_PUBLIC_URL=https://pub-<account-hash>.r2.dev

# AI Photo Editor — Hugging Face (open-source, free tier)
# Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=<huggingface-api-token>
HF_EDIT_MODEL=timbrooks/instruct-pix2pix
HF_INPAINT_MODEL=runwayml/stable-diffusion-inpainting
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-large

# Google Gemini AI editor (legacy, optional — HF is preferred)
# GEMINI_API_KEY=<google-ai-studio-key>
# GOOGLE_API_KEY=<google-ai-studio-key>
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.5-flash

# High-resolution background-removal worker (see backend/ai_worker/README.md).
# Keep the worker private and use the same random token on both services.
AI_SEGMENTATION_URL=https://your-private-gpu-worker.example.com/v1/segment
AI_SEGMENTATION_TOKEN=<random-service-token>
AI_SEGMENTATION_MODEL=ZhengPeng7/BiRefNet_HR-matting
AI_SEGMENTATION_TIMEOUT_SECONDS=150
AI_MAX_SOURCE_BYTES=52428800
AI_MAX_SOURCE_PIXELS=50000000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://admin.snapprint.in,https://snapprint.in

# Allowed hosts — comma-separated (e.g. api.snapprint.in)
# Set to * only in development; always restrict in production
ALLOWED_HOSTS=api.snapprint.in

# Set to "production" to disable /docs, /redoc, /openapi.json and enable HSTS
ENV=production

# Frontend URL (for CORS / links)
FRONTEND_URL=https://admin.snapprint.in

# Public origin of this API. Used for durable customer image URLs.
PUBLIC_API_URL=https://api.snapprint.in

# DEV_BYPASS_SECRET — MUST be empty in production
DEV_BYPASS_SECRET=
