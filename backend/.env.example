# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/snapprint

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Firebase Admin SDK
# Prefer FIREBASE_CREDENTIALS_JSON in hosted environments. Paste the entire
# service-account JSON as one line, or set FIREBASE_CREDENTIALS_PATH when the
# JSON file is mounted on disk.
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Web API Key (from Firebase Console → Project Settings → Web API Key)
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY

# Razorpay — use rzp_live_* keys for production
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Cloudflare R2 (rotate the keys that were previously exposed)
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=snap-photo
R2_PUBLIC_URL=https://pub-REPLACE.r2.dev

# Google Gemini AI editor — set exactly one key in server env.
# The Flutter app must never receive these values.
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
# GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.5-flash

# High-resolution background-removal worker (see backend/ai_worker/README.md).
# Keep the worker private and use the same random token on both services.
AI_SEGMENTATION_URL=https://your-private-gpu-worker.example.com/v1/segment
AI_SEGMENTATION_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
AI_SEGMENTATION_MODEL=ZhengPeng7/BiRefNet_HR-matting
AI_SEGMENTATION_TIMEOUT_SECONDS=150
AI_MAX_SOURCE_BYTES=52428800
AI_MAX_SOURCE_PIXELS=50000000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://admin.snapprint.in,https://snapprint.in

# Allowed hosts — comma-separated (e.g. api.snapprint.in)
# Set to * only in development; always restrict in production
ALLOWED_HOSTS=api.snapprint.in

# Set to "production" to disable /docs, /redoc, /openapi.json and enable HSTS
ENV=production

# Frontend URL (for CORS / links)
FRONTEND_URL=https://admin.snapprint.in

# Public origin of this API. Used for durable customer image URLs.
PUBLIC_API_URL=https://api.snapprint.in

# DEV_BYPASS_SECRET — MUST be empty in production
DEV_BYPASS_SECRET=
