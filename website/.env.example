# Website Environment Variables (SAFE for browser exposure only)
# NEVER put secrets here - only values safe for the browser.
# This file is the template. Copy to `.env` for local development.
# `.env` is gitignored and must never be committed.

# API URL (relative path or full URL)
VITE_API_URL=/api

# App URL (public origin of this site, used for canonical links)
VITE_APP_URL=http://localhost:4173

# Razorpay PUBLIC key only (safe to expose in browser).
# Test key (rzp_test_*) for development, live key (rzp_live_*) for production.
VITE_RAZORPAY_KEY_ID=

# Firebase Web config (public identifiers, safe for browsers — but the Admin
# service-account key must NEVER appear here; it lives only in backend env).
# Find these in Firebase Console → Project Settings → General → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dev-only bypass (NEVER set in production builds).
# The app only honours these when `vite dev` / NODE_ENV=development is active;
# production builds ignore them entirely (see src/config/env.ts).
# Requires the backend DEV_BYPASS_SECRET to match for local QA.
VITE_DEV_PHONE=
VITE_DEV_SECRET=

# DEMO MODE — temporary, owner-requested, until real Firebase keys exist.
# When set (e.g. "123456"), the Auth page accepts this code for ANY valid
# phone number (no SMS). Requires VITE_DEV_SECRET to match the backend
# DEV_BYPASS_SECRET. Visibly badged in the UI. MUST be emptied before launch.
VITE_DEMO_OTP=
